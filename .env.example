# Copy to .env.local and adjust. Everything prefixed VITE_ ships in the browser bundle,
# so never put secrets here. Deployments set these in the Vercel project's Environment Variables.

# Where the API lives. Defaults to same-origin /api (also where the mock API answers).
VITE_API_BASE_URL=http://localhost:4000/api/v1
# true = serve the in-browser mock API with fictional sample data (no backend needed).
VITE_USE_MOCK_API=false
# Absolute origin used in canonical and og:url tags (production).
VITE_SITE_ORIGIN=https://www.nextown.ng
